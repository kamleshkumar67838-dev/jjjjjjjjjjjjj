rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Live Payment Settings (QR Code, UPI ID) - Read by all visitors at checkout
    match /settings/payment {
      allow read: if true;
      allow write: if true;
    }

    // 2. Virtual Cards Catalog - Read by all visitors
    match /cards/{cardId} {
      allow read: if true;
      allow write: if isValidId(cardId);
    }

    // 3. Customer Orders - Created upon checkout, tracked in My Orders, approved in Admin
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow create: if isValidId(orderId);
      allow update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }
  }
}
